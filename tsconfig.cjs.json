{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist/cjs",
    "rootDir": "src",
    "sourceMap": false,
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "types": ["node"],
    "paths": {
      "got": ["./node_modules/got/dist/source/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test", "scripts", "examples"]
}
