{
  "name": "pacer-http",
  "version": "0.1.1",
  "description": "Adaptive client-side rate limiter: wraps any fetch and paces requests from RateLimit / X-RateLimit-* / Retry-After response headers.",
  "type": "module",
  "license": "MIT",
  "author": "Cubex33",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cubex33/pacer-http.git"
  },
  "bugs": {
    "url": "https://github.com/Cubex33/pacer-http/issues"
  },
  "homepage": "https://github.com/Cubex33/pacer-http#readme",
  "keywords": [
    "rate-limit",
    "ratelimit",
    "http",
    "fetch",
    "retry",
    "backoff",
    "429",
    "retry-after",
    "throttle",
    "pacer"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-marker.mjs",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint . && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
